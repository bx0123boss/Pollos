@page "/mesas"
@using Microsoft.Data.SqlClient
@using System.Data
@using FastFoodWeb.Models
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject NavigationManager Nav
<PageTitle>Gestión de Mesas</PageTitle>

<div class="container pb-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-dark">👩‍🍳 Mesas en Cocina</h2>
        <p class="text-muted">Visualizando mesas con pedidos activos</p>
    </div>

    @if (listaMesas == null)
    {
        <div class="d-flex justify-content-center mt-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (listaMesas.Count == 0)
    {
        <div class="alert alert-info text-center mt-4">
            No hay mesas con estatus 'COCINA' actualmente.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var mesa in listaMesas)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="mesa-card @(mesa.Estatus?.ToLower() ?? "")"
                         @onclick="() => SeleccionarMesa(mesa)">
                        <div class="mesa-status-dot"></div>

                        @* BOTÓN DE LAPICITO PARA EDITAR NOMBRE Y CANTIDAD DE PERSONAS *@
                        <button class="btn-edit-mesa" title="Editar Mesa" @onclick:stopPropagation="true" @onclick="() => AbrirModalEditarMesa(mesa)">
                            <i class="bi bi-pencil-fill"></i>
                        </button>

                        <div class="mesa-content">
                            <i class="bi bi-grid-3x3-gap-fill mesa-icon"></i>
                            <h4 class="mesa-title">@mesa.Nombre</h4>
                            <span class="mesa-badge">@mesa.Estatus</span>

                            @* CANTIDAD DE PERSONAS DESDE LA BD *@
                            <div class="mt-2 text-muted small fw-bold">
                                <i class="bi bi-people-fill me-1"></i>@mesa.CantidadPersonas @(mesa.CantidadPersonas == 1 ? "Persona" : "Personas")
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* --- BOTÓN FLOTANTE (FAB) --- *@
<button class="fab-btn shadow" @onclick="AbrirModal">
    <i class="bi bi-plus-lg"></i>
</button>

<ModalAgregarMesa Mostrar="mostrarModal"
                  OnCerrar="CerrarModal"
                  OnMesaAgregada="MesaCreadaDesdePantallaMesas" />

@* --- MODAL DETALLE DE MESA --- *@
@if (mostrarModalDetalle)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg">

                @* Encabezado *@
                <div class="modal-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        <i class="bi bi-receipt-cutoff me-1"></i>
                        Orden: @mesaSeleccionadaNombre
                        <span class="badge bg-secondary fs-6 ms-2">
                            <i class="bi bi-people-fill me-1"></i>@mesaSeleccionadaPersonas @(mesaSeleccionadaPersonas == 1 ? "Persona" : "Personas")
                        </span>
                        <button class="btn btn-outline-warning btn-sm border-0 text-warning ms-1"
                                title="Editar Mesa"
                                @onclick="() => AbrirModalEditarMesa(new Mesa { Id = mesaSeleccionadaId, Nombre = mesaSeleccionadaNombre, CantidadPersonas = mesaSeleccionadaPersonas })">
                            <i class="bi bi-pencil-fill fs-6"></i>
                        </button>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalDetalle"></button>
                </div>

                @* Cuerpo: Lista de Artículos *@
                <div class="modal-body p-0">
                    @if (detallesMesa == null)
                    {
                        <div class="p-5 text-center">
                            <div class="spinner-border text-primary" role="status"></div>
                        </div>
                    }
                    else if (detallesMesa.Count == 0)
                    {
                        <div class="p-5 text-center text-muted">
                            <i class="bi bi-cup-hot fs-1"></i>
                            <p class="mt-2">La mesa está vacía</p>
                        </div>
                    }
                    else
                    {
                        @* BARRA DE ACCIONES MASIVAS *@
                        @if (ObtenerSeleccionados().Count > 0)
                        {
                            <div class="p-2 bg-light border-bottom d-flex align-items-center justify-content-between px-3">
                                <span class="badge bg-primary fs-6">
                                    <i class="bi bi-check2-square me-1"></i> @ObtenerSeleccionados().Count seleccionado(s)
                                </span>
                                <div class="btn-group">
                                    <button class="btn btn-info text-white btn-sm fw-bold" @onclick="AbrirModalMoverMasivo">
                                        <i class="bi bi-arrow-right-left me-1"></i> Transferir Selección
                                    </button>
                                    <button class="btn btn-danger btn-sm fw-bold" @onclick="EliminarArticulosMasivo">
                                        <i class="bi bi-trash3-fill me-1"></i> Cancelar Selección
                                    </button>
                                </div>
                            </div>
                        }

                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th class="text-center" style="width: 40px;">
                                            <input type="checkbox" class="form-check-input"
                                                   checked="@SeleccionarTodosEstado"
                                                   @onchange="ToggleSeleccionarTodos" />
                                        </th>
                                        <th>Cant.</th>
                                        <th>Producto</th>
                                        <th>Comentario</th>
                                        <th class="text-end">Importe</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in detallesMesa)
                                    {
                                        <tr class="@(item.Seleccionado ? "table-active" : "")">
                                            <td class="text-center">
                                                <input type="checkbox" class="form-check-input" @bind="item.Seleccionado" />
                                            </td>
                                            <td class="fw-bold fs-6">@item.Cantidad.ToString("0.##")</td>
                                            <td>
                                                <span class="d-block fw-bold text-dark">@item.NombreProducto</span>
                                            </td>
                                            <td class="small text-muted fst-italic">
                                                @(string.IsNullOrWhiteSpace(item.Comentario) ? "-" : item.Comentario)
                                            </td>
                                            <td class="text-end text-success fw-bold">
                                                $@item.Total.ToString("N2")
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <button class="btn btn-info btn-sm text-white me-1"
                                                             title="Mover a otra mesa"
                                                             @onclick="() => AbrirModalMoverArticuloIndividual(item)">
                                                        <i class="bi bi-arrow-left-right"></i>
                                                    </button>
                                                    <button class="btn btn-outline-warning btn-sm me-1"
                                                            title="Editar artículo"
                                                            @onclick="() => AbrirEditarArticulo(item)">
                                                        <i class="bi bi-pencil-fill"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger btn-sm"
                                                            title="Cancelar artículo"
                                                            @onclick="() => EliminarArticulo(item.IdArticulosMesa)">
                                                        <i class="bi bi-trash3-fill"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-group-divider">
                                    <tr class="bg-light fw-bold">
                                        <td colspan="4" class="text-end">TOTAL MESA:</td>
                                        <td class="text-end fs-5">$@detallesMesa.Sum(x => x.Total).ToString("N2")</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-primary" @onclick="IrAAgregarProductos">
                        <i class="bi bi-cart-plus me-1"></i> Agregar productos
                    </button>

                    @if (detallesMesa != null && detallesMesa.Count > 0)
                    {
                        <button type="button" class="btn btn-success" @onclick="CerrarModalDetalle">
                            <i class="bi bi-printer me-2"></i> Imprimir / Cobrar
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* --- MODAL: EDITAR MESA (NOMBRE Y CANTIDAD DE PERSONAS) --- *@
@if (mostrarModalEditarMesa)
{
    <div class="modal-backdrop fade show" style="z-index: 1060;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1065;">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-warning text-dark">
                    <h6 class="modal-title fw-bold">
                        <i class="bi bi-pencil-square me-1"></i> Editar Mesa
                    </h6>
                    <button type="button" class="btn-close" @onclick="CerrarModalEditarMesa"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Nombre / Número de Mesa:</label>
                        <input type="text" class="form-control" @bind="editMesaNombre" placeholder="Ej. Mesa 5..." />
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-bold small">
                            <i class="bi bi-people-fill me-1"></i> Cantidad de Personas:
                        </label>
                        <input type="number" min="1" max="99" class="form-control" @bind="editMesaPersonas" />
                    </div>
                </div>
                <div class="modal-footer bg-light p-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CerrarModalEditarMesa">Cancelar</button>
                    <button type="button" class="btn btn-warning btn-sm fw-bold" @onclick="GuardarDatosMesa">
                        <i class="bi bi-check-lg me-1"></i> Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* --- MODAL SECUNDARIO: EDITAR ARTÍCULO --- *@
@if (mostrarModalEditarArticulo && articuloEdicion != null)
{
    <div class="modal-backdrop fade show" style="z-index: 1060;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1065;">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-warning text-dark">
                    <h6 class="modal-title fw-bold">
                        <i class="bi bi-pencil-square me-1"></i> Editar @articuloEdicion.NombreProducto
                    </h6>
                    <button type="button" class="btn-close" @onclick="CerrarModalEditar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Cantidad:</label>
                        <input type="number" step="1" min="1" class="form-control" @bind="nuevaCantidadEdicion" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-bold small">Comentario / Notas:</label>
                        <textarea class="form-control" rows="2" @bind="nuevoComentarioEdicion" placeholder="Sin cebolla, extra salsa..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light p-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CerrarModalEditar">Cancelar</button>
                    <button type="button" class="btn btn-warning btn-sm fw-bold" @onclick="GuardarEdicionArticulo">
                        <i class="bi bi-check-lg me-1"></i> Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* --- MODAL SECUNDARIO: MOVER ARTÍCULO(S) DE MESA --- *@
@if (mostrarModalMoverArticulo && itemsAMover.Count > 0)
{
    <div class="modal-backdrop fade show" style="z-index: 1060;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1065;">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-info text-white">
                    <h6 class="modal-title fw-bold">
                        <i class="bi bi-arrow-right-left me-1"></i> Mover Artículo(s)
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalMover"></button>
                </div>
                <div class="modal-body">
                    <p class="small mb-2">
                        @if (itemsAMover.Count == 1)
                        {
                            <span>Mover <strong>@itemsAMover[0].NombreProducto</strong> (x@itemsAMover[0].Cantidad) a:</span>
                        }
                        else
                        {
                            <span>Mover <strong>@itemsAMover.Count artículos seleccionados</strong> a:</span>
                        }
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Seleccionar Mesa Destino:</label>
                        <select class="form-select" @bind="idMesaDestino">
                            <option value="0">-- Selecciona una mesa --</option>
                            @if (listaMesasTodas != null)
                            {
                                @foreach (var m in listaMesasTodas.Where(x => x.Id != mesaSeleccionadaId))
                                {
                                    <option value="@m.Id">@m.Nombre (@m.Estatus)</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light p-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CerrarModalMover">Cancelar</button>
                    <button type="button"
                            class="btn btn-info text-white btn-sm fw-bold"
                            disabled="@(idMesaDestino == 0)"
                            @onclick="GuardarCambioMesaArticulo">
                        <i class="bi bi-check-lg me-1"></i> Transferir
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .mesa-card {
        position: relative;
        height: 180px;
        border-radius: 18px;
        background: #ffffff;
        cursor: pointer;
        transition: all 0.25s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 18px rgba(0,0,0,0.08);
        border: 2px solid transparent;
    }

        .mesa-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 14px 30px rgba(0,0,0,0.15);
        }

    .btn-edit-mesa {
        position: absolute;
        top: 10px;
        left: 10px;
        background: rgba(255, 255, 255, 0.8);
        border: none;
        border-radius: 50%;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6c757d;
        font-size: 0.85rem;
        transition: all 0.22s ease;
        z-index: 5;
    }

        .btn-edit-mesa:hover {
            background: #ffc107;
            color: #000;
            transform: scale(1.15);
        }

    .mesa-content {
        text-align: center;
    }

    .mesa-icon {
        font-size: 2rem;
        opacity: 0.8;
        margin-bottom: 4px;
    }

    .mesa-title {
        font-weight: 700;
        margin-bottom: 4px;
        font-size: 1.15rem;
    }

    .mesa-badge {
        font-size: 0.72rem;
        padding: 4px 12px;
        border-radius: 50px;
        font-weight: 600;
    }

    .mesa-status-dot {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        box-shadow: 0 0 10px rgba(0,0,0,0.3);
    }

    .mesa-card.cocina {
        background: linear-gradient(135deg, #fff4e5, #ffe5cc);
        border-color: #ff9800;
    }

        .mesa-card.cocina .mesa-badge {
            background-color: #ff5722;
            color: white;
        }

        .mesa-card.cocina .mesa-status-dot {
            background-color: #ff5722;
            box-shadow: 0 0 12px #ff5722;
        }

    .mesa-card.nueva {
        background: linear-gradient(135deg, #e3f2fd, #d0e8ff);
        border-color: #2196f3;
    }

        .mesa-card.nueva .mesa-badge {
            background-color: #2196f3;
            color: white;
        }

        .mesa-card.nueva .mesa-status-dot {
            background-color: #2196f3;
            box-shadow: 0 0 12px #2196f3;
        }

    .fab-btn {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 65px;
        height: 65px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0d6efd, #0a58ca);
        color: white;
        border: none;
        font-size: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 1050;
        transition: all 0.25s ease;
        box-shadow: 0 10px 25px rgba(13,110,253,0.4);
    }

        .fab-btn:hover {
            transform: scale(1.1);
            box-shadow: 0 15px 35px rgba(13,110,253,0.6);
        }
</style>

@code {
    private List<Mesa>? listaMesas;
    private bool mostrarModal = false;
    private string nuevaMesaNombre = "";
    private bool mostrarModalDetalle = false;
    private int mesaSeleccionadaId = 0;
    private string mesaSeleccionadaNombre = "";
    private int mesaSeleccionadaPersonas = 1;
    private List<DetallePedido>? detallesMesa;

    // Control de Edición de MESA
    private bool mostrarModalEditarMesa = false;
    private int editMesaId = 0;
    private string editMesaNombre = "";
    private int editMesaPersonas = 1;

    // Control de Edición de ARTÍCULOS
    private bool mostrarModalEditarArticulo = false;
    private DetallePedido? articuloEdicion;
    private decimal nuevaCantidadEdicion = 1;
    private string nuevoComentarioEdicion = "";

    // Control de Mover ARTÍCULO(S)
    private bool mostrarModalMoverArticulo = false;
    private List<DetallePedido> itemsAMover = new();
    private int idMesaDestino = 0;
    private List<Mesa>? listaMesasTodas;

    protected override async Task OnInitializedAsync()
    {
        await CargarMesas();
    }

    // --- SELECCIÓN MÚLTIPLE ---
    private List<DetallePedido> ObtenerSeleccionados()
    {
        return detallesMesa?.Where(x => x.Seleccionado).ToList() ?? new List<DetallePedido>();
    }

    private bool SeleccionarTodosEstado => detallesMesa != null && detallesMesa.Count > 0 && detallesMesa.All(x => x.Seleccionado);

    private void ToggleSeleccionarTodos(ChangeEventArgs e)
    {
        bool chequeado = (bool)(e.Value ?? false);
        if (detallesMesa != null)
        {
            foreach (var item in detallesMesa)
            {
                item.Seleccionado = chequeado;
            }
        }
    }

    // --- MOVER INDIVIDUAL Y MASIVO ---
    private async Task AbrirModalMoverArticuloIndividual(DetallePedido item)
    {
        itemsAMover = new List<DetallePedido> { item };
        idMesaDestino = 0;
        await CargarTodasLasMesas();
        mostrarModalMoverArticulo = true;
    }

    private async Task AbrirModalMoverMasivo()
    {
        itemsAMover = ObtenerSeleccionados();
        if (itemsAMover.Count == 0) return;
        idMesaDestino = 0;
        await CargarTodasLasMesas();
        mostrarModalMoverArticulo = true;
    }

    private void CerrarModalMover()
    {
        mostrarModalMoverArticulo = false;
        itemsAMover.Clear();
        idMesaDestino = 0;
    }

    private async Task CargarTodasLasMesas()
    {
        listaMesasTodas = new List<Mesa>();
        string connectionString = Configuration.GetConnectionString("CadenaSQL");

        using (SqlConnection con = new SqlConnection(connectionString))
        {
            string query = "SELECT IdMesa, Nombre, Estatus, ISNULL(CantidadPersonas, 1) AS CantidadPersonas FROM MESAS WHERE Estatus IN ('COCINA','NUEVA') ORDER BY Nombre";
            SqlCommand cmd = new SqlCommand(query, con);
            await con.OpenAsync();

            using (SqlDataReader reader = await cmd.ExecuteReaderAsync())
            {
                while (await reader.ReadAsync())
                {
                    listaMesasTodas.Add(new Mesa
                    {
                        Id = Convert.ToInt32(reader["IdMesa"]),
                        Nombre = reader["Nombre"].ToString() ?? "",
                        Estatus = reader["Estatus"].ToString() ?? "",
                        CantidadPersonas = Convert.ToInt32(reader["CantidadPersonas"])
                    });
                }
            }
        }
    }

    private async Task GuardarCambioMesaArticulo()
    {
        if (itemsAMover.Count == 0 || idMesaDestino == 0) return;

        string connectionString = Configuration.GetConnectionString("CadenaSQL");
        using (SqlConnection con = new SqlConnection(connectionString))
        {
            await con.OpenAsync();

            // 1. Reasignar todos los artículos seleccionados a la nueva mesa
            string idsStr = string.Join(",", itemsAMover.Select(x => x.IdArticulosMesa));
            string queryUpdateItem = $"UPDATE ArticulosMesa SET IdMesa = @IdMesaDestino WHERE IdArticulosMesa IN ({idsStr})";
            SqlCommand cmdUpdateItem = new SqlCommand(queryUpdateItem, con);
            cmdUpdateItem.Parameters.AddWithValue("@IdMesaDestino", idMesaDestino);
            await cmdUpdateItem.ExecuteNonQueryAsync();

            // 2. Asegurar que la mesa destino pase a estatus 'COCINA'
            string queryMesaDestino = "UPDATE MESAS SET Estatus = 'COCINA' WHERE IdMesa = @IdMesaDestino AND Estatus IN ('LIBRE', 'NUEVA')";
            SqlCommand cmdMesaDestino = new SqlCommand(queryMesaDestino, con);
            cmdMesaDestino.Parameters.AddWithValue("@IdMesaDestino", idMesaDestino);
            await cmdMesaDestino.ExecuteNonQueryAsync();

            // 3. Verificar si la mesa origen se quedó sin artículos activos
            string queryCountOrigen = "SELECT COUNT(*) FROM ArticulosMesa WHERE IdMesa = @IdMesaOrigen AND Estatus != 'CANCELADO'";
            SqlCommand cmdCount = new SqlCommand(queryCountOrigen, con);
            cmdCount.Parameters.AddWithValue("@IdMesaOrigen", mesaSeleccionadaId);
            int articulosRestantes = Convert.ToInt32(await cmdCount.ExecuteScalarAsync());

            if (articulosRestantes == 0)
            {
                string queryLiberarOrigen = "UPDATE MESAS SET Estatus = 'NUEVA' WHERE IdMesa = @IdMesaOrigen";
                SqlCommand cmdLiberar = new SqlCommand(queryLiberarOrigen, con);
                cmdLiberar.Parameters.AddWithValue("@IdMesaOrigen", mesaSeleccionadaId);
                await cmdLiberar.ExecuteNonQueryAsync();

                CerrarModalMover();
                CerrarModalDetalle();
            }
            else
            {
                CerrarModalMover();
                await CargarDetalleMesa();
            }

            await CargarMesas();
        }
    }

    // --- CANCELACIÓN MASIVA ---
    private async Task EliminarArticulosMasivo()
    {
        var seleccionados = ObtenerSeleccionados();
        if (seleccionados.Count == 0) return;

        string motivo = await JS.InvokeAsync<string>("prompt", $"¿Seguro que deseas cancelar los {seleccionados.Count} artículos seleccionados?\nIngresa el motivo de cancelación:");
        if (string.IsNullOrWhiteSpace(motivo)) return;

        string connectionString = Configuration.GetConnectionString("CadenaSQL");
        using (SqlConnection con = new SqlConnection(connectionString))
        {
            string idsStr = string.Join(",", seleccionados.Select(x => x.IdArticulosMesa));
            string query = $"UPDATE ArticulosMesa SET Comentario = @Comentario, Estatus = 'CANCELADO' WHERE IdArticulosMesa IN ({idsStr})";
            SqlCommand cmd = new SqlCommand(query, con);
            cmd.Parameters.AddWithValue("@Comentario", motivo);

            await con.OpenAsync();
            await cmd.ExecuteNonQueryAsync();

            string sqlCount = "SELECT COUNT(*) FROM ArticulosMesa WHERE IdMesa = @IdMesa AND Estatus != 'CANCELADO'";
            SqlCommand cmdCount = new SqlCommand(sqlCount, con);
            cmdCount.Parameters.AddWithValue("@IdMesa", mesaSeleccionadaId);

            int restantes = Convert.ToInt32(await cmdCount.ExecuteScalarAsync());

            if (restantes == 0)
            {
                string sqlUpdate = "UPDATE MESAS SET Estatus = 'NUEVA' WHERE IdMesa = @IdMesa";
                SqlCommand cmdUpdate = new SqlCommand(sqlUpdate, con);
                cmdUpdate.Parameters.AddWithValue("@IdMesa", mesaSeleccionadaId);
                await cmdUpdate.ExecuteNonQueryAsync();

                CerrarModalDetalle();
                await CargarMesas();
            }
            else
            {
                await CargarDetalleMesa();
                await CargarMesas();
            }
        }
    }

    private async Task CargarMesas()
    {
        listaMesas = new List<Mesa>();
        string connectionString = Configuration.GetConnectionString("CadenaSQL");

        using (SqlConnection con = new SqlConnection(connectionString))
        {
            string query = "SELECT IdMesa, Nombre, Estatus, ISNULL(CantidadPersonas, 1) AS CantidadPersonas FROM MESAS WHERE Estatus = 'COCINA' OR Estatus = 'NUEVA' ORDER BY Nombre";

            SqlCommand cmd = new SqlCommand(query, con);
            await con.OpenAsync();

            using (SqlDataReader reader = await cmd.ExecuteReaderAsync())
            {
                while (await reader.ReadAsync())
                {
                    listaMesas.Add(new Mesa
                    {
                        Id = Convert.ToInt32(reader["IdMesa"]),
                        Nombre = reader["Nombre"].ToString() ?? "",
                        Estatus = reader["Estatus"].ToString() ?? "",
                        CantidadPersonas = Convert.ToInt32(reader["CantidadPersonas"])
                    });
                }
            }
        }
    }

    private void AbrirModalEditarMesa(Mesa mesa)
    {
        editMesaId = mesa.Id;
        editMesaNombre = mesa.Nombre;
        editMesaPersonas = mesa.CantidadPersonas > 0 ? mesa.CantidadPersonas : 1;
        mostrarModalEditarMesa = true;
    }

    private void CerrarModalEditarMesa()
    {
        mostrarModalEditarMesa = false;
    }

    private async Task GuardarDatosMesa()
    {
        if (string.IsNullOrWhiteSpace(editMesaNombre) || editMesaPersonas < 1) return;

        string connectionString = Configuration.GetConnectionString("CadenaSQL");
        using (SqlConnection con = new SqlConnection(connectionString))
        {
            string query = "UPDATE MESAS SET Nombre = @Nombre, CantidadPersonas = @CantidadPersonas WHERE IdMesa = @Id";
            SqlCommand cmd = new SqlCommand(query, con);
            cmd.Parameters.AddWithValue("@Nombre", editMesaNombre);
            cmd.Parameters.AddWithValue("@CantidadPersonas", editMesaPersonas);
            cmd.Parameters.AddWithValue("@Id", editMesaId);

            await con.OpenAsync();
            await cmd.ExecuteNonQueryAsync();
        }

        if (mesaSeleccionadaId == editMesaId)
        {
            mesaSeleccionadaNombre = editMesaNombre;
            mesaSeleccionadaPersonas = editMesaPersonas;
        }

        CerrarModalEditarMesa();
        await CargarMesas();
    }

    private void IrAAgregarProductos()
    {
        CerrarModalDetalle();
        Nav.NavigateTo($"/pedido/{mesaSeleccionadaId}");
    }

    private async Task MesaCreadaDesdePantallaMesas(Mesa nuevaMesa)
    {
        mostrarModal = false;
        await CargarMesas();
    }

    private void AbrirModal()
    {
        nuevaMesaNombre = "";
        mostrarModal = true;
    }

    private async Task SeleccionarMesa(Mesa mesa)
    {
        if (mesa.Estatus != null && (mesa.Estatus.Equals("NUEVA", StringComparison.OrdinalIgnoreCase) ||
            mesa.Estatus.Equals("LIBRE", StringComparison.OrdinalIgnoreCase)))
        {
            Nav.NavigateTo($"/pedido/{mesa.Id}");
        }
        else
        {
            mesaSeleccionadaId = mesa.Id;
            mesaSeleccionadaNombre = mesa.Nombre;
            mesaSeleccionadaPersonas = mesa.CantidadPersonas;
            mostrarModalDetalle = true;
            detallesMesa = null;
            await CargarDetalleMesa();
        }
    }

    private async Task CargarDetalleMesa()
    {
        detallesMesa = new List<DetallePedido>();
        string connectionString = Configuration.GetConnectionString("CadenaSQL");

        using (SqlConnection con = new SqlConnection(connectionString))
        {
            string query = @"
                SELECT
                    am.IdArticulosMesa,
                    i.Nombre AS Producto,
                    am.Cantidad,
                    am.Total,
                    am.Comentario
                FROM ArticulosMesa am
                INNER JOIN INVENTARIO i ON am.IdInventario = i.IdInventario
                WHERE am.IdMesa = @IdMesa
                  AND am.Estatus != 'CANCELADO'";

            SqlCommand cmd = new SqlCommand(query, con);
            cmd.Parameters.AddWithValue("@IdMesa", mesaSeleccionadaId);

            await con.OpenAsync();
            using (SqlDataReader reader = await cmd.ExecuteReaderAsync())
            {
                while (await reader.ReadAsync())
                {
                    detallesMesa.Add(new DetallePedido
                    {
                        IdArticulosMesa = Convert.ToInt32(reader["IdArticulosMesa"]),
                        NombreProducto = reader["Producto"].ToString() ?? "",
                        Cantidad = Convert.ToDecimal(reader["Cantidad"]),
                        Total = Convert.ToDecimal(reader["Total"]),
                        Comentario = reader["Comentario"].ToString() ?? "",
                        Seleccionado = false
                    });
                }
            }
        }
    }

    private void AbrirEditarArticulo(DetallePedido item)
    {
        articuloEdicion = item;
        nuevaCantidadEdicion = item.Cantidad;
        nuevoComentarioEdicion = item.Comentario ?? "";
        mostrarModalEditarArticulo = true;
    }

    private void CerrarModalEditar()
    {
        mostrarModalEditarArticulo = false;
        articuloEdicion = null;
    }

    private async Task GuardarEdicionArticulo()
    {
        if (articuloEdicion == null || nuevaCantidadEdicion <= 0) return;

        string connectionString = Configuration.GetConnectionString("CadenaSQL");
        using (SqlConnection con = new SqlConnection(connectionString))
        {
            decimal precioUnitario = articuloEdicion.Cantidad > 0 ? (articuloEdicion.Total / articuloEdicion.Cantidad) : 0;
            decimal nuevoTotal = precioUnitario * nuevaCantidadEdicion;

            string query = @"UPDATE ArticulosMesa
                            SET Cantidad = @Cantidad,
                                Total = @Total,
                                Comentario = @Comentario
                            WHERE IdArticulosMesa = @Id";

            SqlCommand cmd = new SqlCommand(query, con);
            cmd.Parameters.AddWithValue("@Cantidad", nuevaCantidadEdicion);
            cmd.Parameters.AddWithValue("@Total", nuevoTotal);
            cmd.Parameters.AddWithValue("@Comentario", nuevoComentarioEdicion);
            cmd.Parameters.AddWithValue("@Id", articuloEdicion.IdArticulosMesa);

            await con.OpenAsync();
            await cmd.ExecuteNonQueryAsync();
        }

        CerrarModalEditar();
        await CargarDetalleMesa();
    }

    private async Task EliminarArticulo(int idArticulo)
    {
        string motivo = await JS.InvokeAsync<string>("prompt", "¿Seguro que deseas cancelar este artículo?\nIngresa el motivo de cancelación:");
        if (string.IsNullOrWhiteSpace(motivo)) return;

        string connectionString = Configuration.GetConnectionString("CadenaSQL");
        using (SqlConnection con = new SqlConnection(connectionString))
        {
            string query = "UPDATE ArticulosMesa SET Comentario = @Comentario, Estatus = 'CANCELADO' WHERE IdArticulosMesa = @Id";
            SqlCommand cmd = new SqlCommand(query, con);
            cmd.Parameters.AddWithValue("@Id", idArticulo);
            cmd.Parameters.AddWithValue("@Comentario", motivo);

            await con.OpenAsync();
            await cmd.ExecuteNonQueryAsync();

            string sqlCount = "SELECT count(*) FROM ArticulosMesa WHERE IdMesa = @IdMesa AND Estatus != 'CANCELADO'";
            SqlCommand cmdCount = new SqlCommand(sqlCount, con);
            cmdCount.Parameters.AddWithValue("@IdMesa", mesaSeleccionadaId);

            int restantes = Convert.ToInt32(await cmdCount.ExecuteScalarAsync());

            if (restantes == 0)
            {
                string sqlUpdate = "UPDATE MESAS SET Estatus = 'NUEVA' WHERE IdMesa = @IdMesa";
                SqlCommand cmdUpdate = new SqlCommand(sqlUpdate, con);
                cmdUpdate.Parameters.AddWithValue("@IdMesa", mesaSeleccionadaId);
                await cmdUpdate.ExecuteNonQueryAsync();

                CerrarModalDetalle();
                await CargarMesas();
            }
            else
            {
                await CargarDetalleMesa();
                await CargarMesas();
            }
        }
    }

    private void CerrarModalDetalle() => mostrarModalDetalle = false;
    private void CerrarModal() => mostrarModal = false;

    public class DetallePedido
    {
        public int IdArticulosMesa { get; set; }
        public string NombreProducto { get; set; } = "";
        public decimal Cantidad { get; set; }
        public decimal Total { get; set; }
        public string Comentario { get; set; } = "";
        public bool Seleccionado { get; set; } = false;
    }
}